# Tushare Pro API Token（2000 积分）
TUSHARE_TOKEN=your_token_here

# 同花顺金融数据 API Key（https://fuyao.aicubes.cn 用同花顺账号登录后签发）
# 提供板块行业指数、涨停池、指数快照等数据（provider 映射表默认 sectors/limit_up 用它）
THS_API_KEY=your_ths_api_key_here

# 应用配置
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 可选：写接口鉴权（配置后 POST/PUT/DELETE 需带 X-API-Token 头，个人部署建议设置）
# API_TOKEN=

# 可选：生产环境 CORS 白名单（逗号分隔；不配置则不加 CORS 中间件）
# CORS_ORIGINS=https://your-domain.com
